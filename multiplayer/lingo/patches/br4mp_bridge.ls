-- =====================================================================
--  br4mp_bridge.ls  —  Burnin' Rubber 4 online bridge (single file)
--
--  Generated by tools/check-lingo.mjs --build from
--      br4mp_config.ls + br4mp_net.ls + br4mp_game.ls
--  Do not edit by hand: edit the three sources and rebuild.
--
--  INSTALL: paste this whole file into ONE cast member whose type is
--  "Movie Script" (not Behavior, not Parent), and tick
--  "Include in Shockwave" in that member's properties if you publish a
--  .dcr. Then call BR4MPDiagnostics() from the Message window to verify.
-- =====================================================================

-- =====================================================================
--  br4mp_config.ls  —  Burnin' Rubber 4 online bridge: configuration
--  Movie script (cast member type: Movie Script). Load it before
--  br4mp_net.ls and br4mp_game.ls, or use the single-file build
--  br4mp_bridge.ls instead.
--
--  v1.1 — fixes "handler not defined #Active":
--    `gBR4MP = gBR4MP or [:]` was wrong. Lingo's `or` is a boolean /
--    bitwise operator, so that expression evaluates to TRUE and every
--    later `gBR4MP.active` became a handler lookup on an integer.
--    Initialisation is now `ilk()`-based (see BR4MPEnsure).
-- =====================================================================

global gBR4MP

-- Bump when the script changes; shown by BR4MPDiagnostics.
on BR4MPVersion
  return "1.1"
end

-- ---------------------------------------------------------------------
--  Initialisation
-- ---------------------------------------------------------------------

-- Idempotent: creates gBR4MP if it is missing or damaged, keeps the
-- current session state when it is already a valid property list.
-- Every entry point calls this, so call order never matters.
on BR4MPEnsure
  if ilk(gBR4MP) <> #propList then
    gBR4MP = [:]
    BR4MPResetProps
  end if
  return gBR4MP
end

-- Full reset: wipes session state and writes every key the bridge uses,
-- so no handler ever reads VOID from the property list.
on BR4MPResetProps
  gBR4MP.active = FALSE
  gBR4MP.version = BR4MPVersion()

  -- Point this at the machine running packages/server (no trailing slash).
  -- Shockwave Player may only reach the host it was served from unless a
  -- crossdomain.xml allows more; see docs/06-operations.md.
  gBR4MP.baseURL = "http://localhost:8080"

  -- Identity shown in the roster and chat.
  gBR4MP.playerName = "Racer"
  gBR4MP.vehicle = "PlayerCar"
  gBR4MP.skin = 0

  -- Networking cadence: 20 Hz state uplink, 15 s long-poll hold,
  -- 2.5 s ping, 50 ms send flush.
  gBR4MP.stateHz = 20
  gBR4MP.pollWait = 15
  gBR4MP.pingMs = 2500
  gBR4MP.resumeWindowMs = 60000

  -- Debug: put every parsed protocol line in the Message window.
  gBR4MP.trace = FALSE

  -- Transport handles (0 = no request in flight).
  gBR4MP.connectNet = 0
  gBR4MP.pollNet = 0
  gBR4MP.connectedAt = 0
  gBR4MP.lastFlush = 0
  gBR4MP.lastPing = 0
  gBR4MP.stateSent = 0
  gBR4MP.pingSentAt = 0
  gBR4MP.pingId = 0
  gBR4MP.rttMs = 0
  gBR4MP.tickRate = 20
  gBR4MP.lastError = ""

  -- Session state.
  gBR4MP.token = ""
  gBR4MP.playerId = 0
  gBR4MP.roomId = ""
  gBR4MP.trackId = ""
  gBR4MP.mode = 0
  gBR4MP.worldIndex = 0
  gBR4MP.startTick = 0
  gBR4MP.seq = 0
  gBR4MP.ackTick = 0
  gBR4MP.snapshotTick = 0
  gBR4MP.localVel = vector(0, 0, 0)

  -- Race / HUD state.
  gBR4MP.phase = 0
  gBR4MP.lap = 0
  gBR4MP.cp = 0
  gBR4MP.totalLaps = 1
  gBR4MP.countdownMs = 0
  gBR4MP.statusText = ""

  -- Collections.
  gBR4MP.players = [:]
  gBR4MP.remotes = [:]
  gBR4MP.chat = []
  gBR4MP.standings = []
  gBR4MP.sendQueue = []
  gBR4MP.pendingEntries = []
  gBR4MP.invitedRoom = 0
  gBR4MP.chatMember = VOID
end

-- Full reset, kept for BR4MPStart and for manual recovery.
on BR4MPDefaults
  gBR4MP = [:]
  BR4MPResetProps
  return gBR4MP
end

-- ---------------------------------------------------------------------
--  Public entry points
-- ---------------------------------------------------------------------

-- menu button:  mode 0 = free roam, 1 = race
--               worldIndex 0 City, 1 Desert, 2 Jungle, 3 Industrial, 4 Snow
--               trackId "city-1", "" for free roam
on BR4MPStart mode, worldIndex, trackId
  BR4MPDefaults
  gBR4MP.mode = mode
  gBR4MP.worldIndex = worldIndex
  gBR4MP.trackId = trackId
  gBR4MP.active = TRUE
  gBR4MP.statusText = "Connecting to " & gBR4MP.baseURL & " ..."
  BR4MPConnect
  return gBR4MP.active
end

on BR4MPStop
  BR4MPEnsure
  if gBR4MP.token <> "" then BR4MPSendLine("LEAVE|")
  BR4MPFlush
  gBR4MP.active = FALSE
  gBR4MP.token = ""
  BR4MPCancelPoll
end

on BR4MPActive
  if ilk(gBR4MP) <> #propList then return FALSE
  return gBR4MP.active = TRUE
end

-- ---------------------------------------------------------------------
--  Diagnostics — call this from the Message window after pasting scripts:
--     put BR4MPDiagnostics()
--  It only uses configuration-level state, so it works even when the
--  transport or game scripts are missing.
-- ---------------------------------------------------------------------
on BR4MPDiagnostics
  pWasBroken = FALSE
  if ilk(gBR4MP) <> #propList then
    pWasBroken = TRUE
    put "gBR4MP was " & string(ilk(gBR4MP)) & " (should be #propList) — repairing."
    BR4MPEnsure
  end if

  put "=== br4mp bridge " & BR4MPVersion() & " ==="
  put "gBR4MP ilk      : " & string(ilk(gBR4MP)) & "  (must be #propList)"
  put "baseURL         : " & string(gBR4MP.baseURL)
  put "active          : " & string(gBR4MP.active)
  put "player          : " & string(gBR4MP.playerName) & " / " & string(gBR4MP.vehicle)
  put "token           : " & string(gBR4MP.token)
  put "room            : " & string(gBR4MP.roomId) & "  track=" & string(gBR4MP.trackId)
  put "playerId        : " & string(gBR4MP.playerId)
  put "phase / lap     : " & string(gBR4MP.phase) & " / " & string(gBR4MP.lap) & " of " & string(gBR4MP.totalLaps)
  put "players/remotes : " & string(gBR4MP.players.count) & " / " & string(gBR4MP.remotes.count)
  put "queue / rtt     : " & string(gBR4MP.sendQueue.count) & " / " & string(gBR4MP.rttMs) & " ms"
  put "last error      : " & string(gBR4MP.lastError)

  if pWasBroken then
    put "gBR4MP has been reinitialised. Call BR4MPStart again."
  end if
  put "If gBR4MP ilk is #propList but a BR4MP* handler is missing,"
  put "the script that defines it is not part of the movie: paste the"
  put "member as a Movie Script and tick 'Include in Shockwave' in its"
  put "cast member properties. See TROUBLESHOOTING.md."
  return gBR4MP.statusText
end


-- =====================================================================
--  br4mp_net.ls  —  Burnin' Rubber 4 online bridge: text transport
--  Movie script (cast member type: Movie Script). Requires br4mp_config.ls,
--  or use the single-file build br4mp_bridge.ls.
--
--  Shockwave Player cannot open a WebSocket, so the bridge speaks the
--  line-oriented text profile over HTTP (see docs/02-protocol.md §5):
--
--    POST /mp/connect?...            once, gets WELCOME/JOINED/roster
--    GET  /mp/poll?token=..&wait=15  held open, returns queued lines
--    POST /mp/send?token=..&d=..     state uplink + chat/actions
--
--  Everything here is asynchronous: BR4MPFrame (called once per frame by
--  the game) pumps the completed requests, so nothing ever blocks the
--  Director playback head.
-- =====================================================================

global gBR4MP

-- ── connect ────────────────────────────────────────────────────────────
on BR4MPConnect
  BR4MPEnsure
  pURL = gBR4MP.baseURL & "/mp/connect" & "?name=" & BR4MPEncode(gBR4MP.playerName) & ¬
         "&v=1&cv=director&veh=" & BR4MPEncode(gBR4MP.vehicle) & ¬
         "&sk=" & string(gBR4MP.skin) & ¬
         "&m=" & string(gBR4MP.mode) & ¬
         "&w=" & string(gBR4MP.worldIndex) & ¬
         "&tid=" & BR4MPEncode(gBR4MP.trackId) & ¬
         "&tok=" & BR4MPEncode(gBR4MP.token)

  gBR4MP.connectNet = postNetText(pURL, "")
  gBR4MP.connectedAt = the milliseconds
  gBR4MP.statusText = "Connecting to " & gBR4MP.baseURL & " ..."
  BR4MPTrace("connect -> " & pURL)
end

-- ── per-frame pump ─────────────────────────────────────────────────────
on BR4MPFrame
  BR4MPEnsure
  if not BR4MPActive() then return

  -- 1. connection reply
  if gBR4MP.connectNet > 0 and netDone(gBR4MP.connectNet) then
    pNet = gBR4MP.connectNet
    pText = netTextResult(pNet)
    pErr = netError(pNet)
    gBR4MP.connectNet = 0
    if pErr <> "" then gBR4MP.lastError = "net: " & pErr
    BR4MPHandleText(pText)
    BR4MPStartPoll
  end if

  -- 2. held poll reply: parse, then immediately queue the next one
  if gBR4MP.pollNet > 0 and netDone(gBR4MP.pollNet) then
    pText = netTextResult(gBR4MP.pollNet)
    gBR4MP.pollNet = 0
    BR4MPHandleText(pText)
    if BR4MPActive() then BR4MPStartPoll
  end if

  -- 3. flush queued uplinks at most every 50 ms
  if gBR4MP.lastFlush = VOID then gBR4MP.lastFlush = the milliseconds
  if the milliseconds - gBR4MP.lastFlush >= 50 then BR4MPFlush
end

on BR4MPStartPoll
  BR4MPEnsure
  if not BR4MPActive() then return
  if gBR4MP.token = "" then return
  if gBR4MP.pollNet > 0 then return
  pURL = gBR4MP.baseURL & "/mp/poll?token=" & BR4MPEncode(gBR4MP.token) & ¬
         "&wait=" & string(gBR4MP.pollWait) & "&r=" & string(the milliseconds)
  gBR4MP.pollNet = getNetText(pURL)
end

on BR4MPCancelPoll
  BR4MPEnsure
  -- nothing to cancel in Lingo; just forget the handle so its result is ignored
  gBR4MP.pollNet = 0
end

-- ── uplink ─────────────────────────────────────────────────────────────
-- Queue one protocol line (no newline needed) for the next flush.
on BR4MPSendLine pLine
  BR4MPEnsure
  if pLine = "" then return
  gBR4MP.sendQueue.add(pLine)
end

on BR4MPSendNow pLine
  BR4MPSendLine(pLine)
  BR4MPFlush
end

on BR4MPFlush
  BR4MPEnsure
  if gBR4MP.token = "" then return
  if gBR4MP.sendQueue.count = 0 then return
  pPayload = gBR4MP.sendQueue[1]
  repeat with i = 2 to gBR4MP.sendQueue.count
    pPayload = pPayload & numToChar(10) & gBR4MP.sendQueue[i]
  end repeat
  gBR4MP.sendQueue = []
  gBR4MP.lastFlush = the milliseconds
  pURL = gBR4MP.baseURL & "/mp/send?token=" & BR4MPEncode(gBR4MP.token) & ¬
         "&d=" & BR4MPEncode(pPayload)
  -- fire and forget: replies (usually empty) are dropped on purpose
  postNetText(pURL, "")
end

-- ── parsing ────────────────────────────────────────────────────────────
-- One response is many lines; each line is TAG|k=v,k=v,...
on BR4MPHandleText pText
  if pText = "" then return
  pCount = the number of lines in pText
  repeat with i = 1 to pCount
    pLine = pText.line[i]
    if pLine <> "" then BR4MPHandleLine(pLine)
  end repeat
end

on BR4MPHandleLine pLine
  BR4MPTrace("<- " & pLine)
  pBar = offset("|", pLine)
  if pBar > 0 then
    pTag = pLine.char[1 .. pBar - 1]
    pBody = pLine.char[pBar + 1 .. pLine.length]
  else
    pTag = pLine
    pBody = ""
  end if

  case pTag of
    "WELCOME":
      gBR4MP.playerId = BR4MPNum(pBody, "i")
      gBR4MP.token = BR4MPStr(pBody, "k")
      gBR4MP.tickRate = BR4MPNum(pBody, "r")
      gBR4MP.statusText = "Connected as #" & string(gBR4MP.playerId)

    "JOINED":
      gBR4MP.roomId = BR4MPStr(pBody, "room")
      gBR4MP.mode = BR4MPNum(pBody, "m")
      gBR4MP.worldIndex = BR4MPNum(pBody, "w")
      gBR4MP.trackId = BR4MPStr(pBody, "tid")
      gBR4MP.totalLaps = BR4MPNum(pBody, "laps")
      gBR4MP.startTick = BR4MPNum(pBody, "st")
      gBR4MP.players = [:]
      BR4MPGameJoined gBR4MP.roomId, gBR4MP.trackId

    "PJ":
      pPlayer = [#id: BR4MPNum(pBody, "i"), #name: BR4MPStr(pBody, "n"), ¬
                 #vehicle: BR4MPStr(pBody, "veh"), #ready: BR4MPNum(pBody, "r")]
      gBR4MP.players[pPlayer.id] = pPlayer
      BR4MPGamePlayerJoin(pPlayer)

    "PL":
      pId = BR4MPNum(pBody, "i")
      gBR4MP.players.deleteProp(pId)
      BR4MPGamePlayerLeave(pId)

    "C":
      pChannel = BR4MPNum(pBody, "ch")
      pName = BR4MPStr(pBody, "n")
      pTextValue = BR4MPStr(pBody, "x")
      gBR4MP.chat.add([#name: pName, #text: pTextValue, #channel: pChannel])
      if gBR4MP.chat.count > 60 then gBR4MP.chat.deleteAt(1)
      BR4MPGameChat(pName, pTextValue, pChannel)

    "SN":
      gBR4MP.snapshotTick = BR4MPNum(pBody, "t")
      gBR4MP.ackTick = gBR4MP.snapshotTick
      gBR4MP.pendingEntries = []

    "E":
      if gBR4MP.pendingEntries <> VOID then gBR4MP.pendingEntries.add(pBody)

    "RS":
      gBR4MP.phase = BR4MPNum(pBody, "ph")
      gBR4MP.lap = BR4MPNum(pBody, "l")
      gBR4MP.totalLaps = BR4MPNum(pBody, "tl")
      gBR4MP.countdownMs = BR4MPNum(pBody, "cd")
      BR4MPGameRaceState(gBR4MP.phase, gBR4MP.lap, gBR4MP.totalLaps, gBR4MP.countdownMs)

    "ST":
      BR4MPGameStanding(BR4MPNum(pBody, "i"), BR4MPNum(pBody, "l"), BR4MPNum(pBody, "c"), ¬
                        BR4MPNum(pBody, "f"), BR4MPNum(pBody, "ft"))

    "EV":
      BR4MPGameEvent(BR4MPNum(pBody, "e"), BR4MPNum(pBody, "a"), BR4MPNum(pBody, "t"), ¬
                     BR4MPNum(pBody, "val"), [BR4MPNum(pBody, "px"), BR4MPNum(pBody, "py"), BR4MPNum(pBody, "pz")])

    "COR":
      BR4MPGameCorrection(BR4MPNum(pBody, "rs"), ¬
                          [BR4MPNum(pBody, "px"), BR4MPNum(pBody, "py"), BR4MPNum(pBody, "pz")], ¬
                          [BR4MPNum(pBody, "rx"), BR4MPNum(pBody, "ry"), BR4MPNum(pBody, "rz"), BR4MPNum(pBody, "rw")])

    "PONG":
      if gBR4MP.pingSentAt > 0 then
        gBR4MP.rttMs = the milliseconds - gBR4MP.pingSentAt
        gBR4MP.pingSentAt = 0
      end if

    "ERR":
      gBR4MP.lastError = "server: " & BR4MPStr(pBody, "m") & " (code " & string(BR4MPNum(pBody, "c")) & ")"
      BR4MPGameError(BR4MPNum(pBody, "c"), BR4MPStr(pBody, "m"))

    otherwise:
      -- unknown tags are ignored so a newer server cannot break an old build
  end case

  -- entries arrive after their SN header, one line each
  if pTag = "E" then BR4MPGameSnapshotEntry(pBody)
end

-- ── field helpers ──────────────────────────────────────────────────────
-- Returns the text after pMarker in pLine (whole line when missing).
on BR4MPAfter pLine, pMarker
  pAt = offset(pMarker, pLine)
  if pAt = 0 then return pLine
  return pLine.char[pAt + pMarker.length .. pLine.length]
end

on BR4MPParam pBody, pKey
  pCount = the number of items in pBody
  repeat with i = 1 to pCount
    pItem = pBody.item[i]
    pEq = offset("=", pItem)
    if pEq > 0 then
      if pItem.char[1 .. pEq - 1] = pKey then return pItem.char[pEq + 1 .. pItem.length]
    end if
  end repeat
  return ""
end

on BR4MPNum pBody, pKey
  pValue = BR4MPParam(pBody, pKey)
  if pValue = "" then return 0
  return value(pValue)
end

on BR4MPStr pBody, pKey
  return BR4MPDecode(BR4MPParam(pBody, pKey))
end

-- ── percent encoding (Lingo has no built-in codec) ─────────────────────
on BR4MPEncode pText
  pOut = ""
  pLen = pText.length
  repeat with i = 1 to pLen
    pCh = pText.char[i]
    pCode = charToNum(pCh)
    if (pCode >= 48 and pCode <= 57) or (pCode >= 65 and pCode <= 90) or (pCode >= 97 and pCode <= 122) then
      pOut = pOut & pCh
    else if pCh = "." or pCh = "-" or pCh = "_" then
      pOut = pOut & pCh
    else
      pOut = pOut & "%" & BR4MPHex(pCode div 16) & BR4MPHex(pCode mod 16)
    end if
  end repeat
  return pOut
end

on BR4MPHex pValue
  pDigits = "0123456789ABCDEF"
  return pDigits.char[(pValue + 1)]
end

on BR4MPDecode pText
  pOut = ""
  pLen = pText.length
  i = 1
  repeat while i <= pLen
    pCh = pText.char[i]
    if pCh = "%" and i + 2 <= pLen then
      pCode = BR4MPUnHex(pText.char[i + 1]) * 16 + BR4MPUnHex(pText.char[i + 2])
      pOut = pOut & numToChar(pCode)
      i = i + 3
    else if pCh = "+" then
      pOut = pOut & " "
      i = i + 1
    else
      pOut = pOut & pCh
      i = i + 1
    end if
  end repeat
  return pOut
end

on BR4MPUnHex pCh
  pCode = charToNum(pCh)
  if pCode >= 48 and pCode <= 57 then return pCode - 48
  if pCode >= 65 and pCode <= 70 then return pCode - 55
  if pCode >= 97 and pCode <= 102 then return pCode - 87
  return 0
end

on BR4MPTrace pText
  if ilk(gBR4MP) <> #propList then return
  if gBR4MP.trace then put pText
end


-- =====================================================================
--  br4mp_game.ls  —  Burnin' Rubber 4 online bridge: game glue
--  Movie script (cast member type: Movie Script). Requires br4mp_config.ls
--  and br4mp_net.ls, or use the single-file build br4mp_bridge.ls.
--
--  This is the only file with game-specific code. It reads the local car
--  that "[PS] Advanced Car.ls enterFrame" already simulates, sends its
--  transform to the server, and keeps a list of remote cars in the 3D
--  scene. Nothing here reimplements physics: the local car stays
--  authoritative, the server only validates it.
--
--  The two accessors marked ADAPT are the only places that assume a
--  particular build of the movie. Everything else uses the text protocol.
-- =====================================================================

global gBR4MP

-- ── ADAPT: local car accessors ─────────────────────────────────────────
-- These four handlers are the only build-specific code in the bridge.
-- Each one is a single expression on purpose: probing for different
-- property layouts with `if x.prop <> VOID` raises "property not found"
-- on script objects in Lingo, so edit the expression instead of guessing.

-- The object the hover physics drives in [PS] Advanced Car.ls.
on BR4MPLocalCar
  return gGame.me.car
end

-- The car's transform in world space (metres, Z-up).
on BR4MPLocalTransform
  return BR4MPLocalCar().transform
end

-- Heading in radians. The physics keeps the car upright, so a single yaw
-- around Z is enough for the wire (rx=ry=0). If your build stores the
-- heading in degrees on the script object, use:
--     return gGame.me.angle * pi() / 180
on BR4MPLocalYaw
  pRot = BR4MPLocalTransform().rotation
  if ilk(pRot) = #vector then return pRot.z * pi() / 180
  if ilk(pRot) = #propList then return 2 * BR4MPAtan2(pRot.z, pRot.w)
  return 0
end

-- Ground speed in m/s, as the speedometer uses it.
on BR4MPLocalSpeed
  return gGame.me.speed
end

-- Velocity in m/s; only used as advisory info in the snapshot.
on BR4MPLocalVelocity
  pVel = gBR4MP.localVel
  if ilk(pVel) = #vector then return pVel
  return vector(0, 0, 0)
end

on BR4MPLocalHealth
  return gGame.me.health
end

-- ── per-frame entry point (call from a movie script enterFrame) ────────
on BR4MPGameFrame
  BR4MPEnsure
  if not BR4MPActive() then return
  BR4MPFrame                       -- transport pump (br4mp_net.ls)
  BR4MPUplink
  BR4MPPingIfDue
  BR4MPAnimateRemotes
  BR4MPUpdateStatus
end

on BR4MPUplink
  BR4MPEnsure
  if the milliseconds - gBR4MP.stateSent < (1000 / gBR4MP.stateHz) then return
  gBR4MP.stateSent = the milliseconds

  pTransform = BR4MPLocalTransform()
  pPos = pTransform.position
  pVel = BR4MPLocalVelocity()
  pYaw = BR4MPLocalYaw()
  gBR4MP.localVel = pVel
  gBR4MP.seq = gBR4MP.seq + 1

  pLine = "STATE|s=" & string(gBR4MP.seq) & ¬
          ",ack=" & string(gBR4MP.ackTick) & ¬
          ",f=0" & ¬
          ",px=" & BR4MPFixed(pPos.x) & ",py=" & BR4MPFixed(pPos.y) & ",pz=" & BR4MPFixed(pPos.z) & ¬
          ",rx=0,ry=0" & ¬
          ",rz=" & BR4MPFixed(sin(pYaw / 2)) & ",rw=" & BR4MPFixed(cos(pYaw / 2)) & ¬
          ",vx=" & BR4MPFixed(pVel.x) & ",vy=" & BR4MPFixed(pVel.y) & ",vz=" & BR4MPFixed(pVel.z) & ¬
          ",h=" & string(round(BR4MPLocalHealth())) & ¬
          ",l=" & string(gBR4MP.lap) & ",c=" & string(gBR4MP.cp) & ¬
          ",sp=" & string(round(BR4MPLocalSpeed()))
  BR4MPSendLine(pLine)
end

on BR4MPFixed pValue
  return string(round(pValue * 100) / 100.0)
end

on BR4MPPingIfDue
  BR4MPEnsure
  if the milliseconds - gBR4MP.lastPing < gBR4MP.pingMs then return
  gBR4MP.lastPing = the milliseconds
  gBR4MP.pingSentAt = the milliseconds
  gBR4MP.pingId = gBR4MP.pingId + 1
  BR4MPSendLine("PING|n=" & string(gBR4MP.pingId) & ",ct=" & string(the milliseconds))
end

-- ── snapshot entries ───────────────────────────────────────────────────
on BR4MPGameSnapshotEntry pBody
  BR4MPEnsure
  pId = BR4MPNum(pBody, "i")
  if pId = gBR4MP.playerId then return          -- that's us; the local car wins

  pMask = BR4MPNum(pBody, "m")
  pRemote = gBR4MP.remotes[pId]
  if pRemote = VOID then
    pRemote = [#id: pId, #pos: vector(0, 0, 0), #shown: VOID, #yaw: 0, ¬
               #health: 100, #speed: 0, #seenAt: the milliseconds, #mesh: VOID]
    gBR4MP.remotes[pId] = pRemote
  end if

  if bitAnd(pMask, 1) then
    pRemote.pos = vector(BR4MPNum(pBody, "px"), BR4MPNum(pBody, "py"), BR4MPNum(pBody, "pz"))
    if pRemote.shown = VOID then pRemote.shown = pRemote.pos
  end if
  if bitAnd(pMask, 2) then
    pQZ = BR4MPNum(pBody, "rz")
    pQW = BR4MPNum(pBody, "rw")
    if pQW = 0 and pQZ = 0 then
      pRemote.yaw = 0
    else
      pRemote.yaw = 2 * BR4MPAtan2(pQZ, pQW)
    end if
  end if
  if bitAnd(pMask, 8) then pRemote.health = BR4MPNum(pBody, "h")
  if bitAnd(pMask, 64) then pRemote.speed = BR4MPNum(pBody, "sp")
  pRemote.seenAt = the milliseconds
  BR4MPGameRemoteSpawn(pRemote)
end

-- ── ADAPT: remote car meshes ───────────────────────────────────────────
-- Default implementation: ask the movie for a car model through the same
-- routine the traffic system uses. If your build has no such routine,
-- create a clone of the player car here and return it.
on BR4MPGameRemoteSpawn pRemote
  if pRemote.mesh <> VOID then return pRemote.mesh
  -- ADAPT: create (or borrow from the traffic pool) a car model for this
  -- opponent, store it in pRemote.mesh and return it. Example for a movie
  -- whose traffic system exposes a spawner:
  --     pRemote.mesh = gGame.world.SpawnTrafficCar(pRemote.id)
  --     return pRemote.mesh
  -- Returning VOID is safe: the roster, chat and race logic keep working,
  -- the opponent is just not drawn.
  return VOID
end

on BR4MPAnimateRemotes
  BR4MPEnsure
  pIds = gBR4MP.remotes.getPropList()
  pNow = the milliseconds
  repeat with i = 1 to pIds.count
    pId = pIds[i]
    pRemote = gBR4MP.remotes[pId]
    if pRemote <> VOID then
      if pNow - pRemote.seenAt > 4000 then
        -- silent for 4 s: hide the car but keep the roster entry
        BR4MPHideRemote(pRemote)
      else
        -- snapshots arrive at 20 Hz; ease the rendered car towards the last
        -- authoritative position so it looks smooth at 30/60 fps
        if pRemote.shown = VOID then pRemote.shown = pRemote.pos
        pRemote.shown = BR4MPLerp(pRemote.shown, pRemote.pos, 0.35)
        if pRemote.mesh <> VOID then pRemote.mesh.visible = TRUE
        BR4MPPlaceRemote(pRemote)
      end if
    end if
  end repeat
end

on BR4MPPlaceRemote pRemote
  if pRemote.mesh = VOID then return
  pMesh = pRemote.mesh
  pMesh.transform.position = pRemote.shown
  pMesh.transform.rotation = vector(0, 0, pRemote.yaw)
end

on BR4MPHideRemote pRemote
  if pRemote.mesh = VOID then return
  pRemote.mesh.visible = FALSE
end

-- Lingo has no two-argument atan; this is the usual quadrant fix-up.
on BR4MPAtan2 pY, pX
  if pX > 0 then return atan(pY / pX)
  if pX < 0 and pY >= 0 then return atan(pY / pX) + pi()
  if pX < 0 and pY < 0 then return atan(pY / pX) - pi()
  if pX = 0 and pY > 0 then return pi() / 2
  if pX = 0 and pY < 0 then return -pi() / 2
  return 0
end

on BR4MPLerp pTarget, pToward, pAlpha
  if ilk(pTarget) <> #vector then return pToward
  if ilk(pToward) <> #vector then return pTarget
  return pTarget + (pToward - pTarget) * pAlpha
end

-- ── callbacks from br4mp_net.ls ────────────────────────────────────────
on BR4MPGameJoined pRoomId, pTrackId
  BR4MPEnsure
  gBR4MP.roomId = pRoomId
  gBR4MP.trackId = pTrackId
  gBR4MP.remotes = [:]
  gBR4MP.statusText = "Joined " & pRoomId
end

on BR4MPGamePlayerJoin pPlayer
  -- roster is kept in gBR4MP.players by the transport; a chat notice is nice
  BR4MPShowChat("SYSTEM", pPlayer.name & " joined.", 2)
end

on BR4MPGamePlayerLeave pId
  BR4MPEnsure
  pRemote = gBR4MP.remotes[pId]
  if pRemote <> VOID then
    if pRemote.mesh <> VOID then pRemote.mesh.visible = FALSE
    gBR4MP.remotes.deleteProp(pId)
  end if
end

on BR4MPGameChat pName, pText, pChannel
  BR4MPShowChat(pName, pText, pChannel)
end

on BR4MPGameRaceState pPhase, pLap, pTotalLaps, pCountdownMs
  gBR4MP.phase = pPhase
  gBR4MP.lap = pLap
  gBR4MP.totalLaps = pTotalLaps
  gBR4MP.countdownMs = pCountdownMs
  if pPhase = 1 then
    BR4MPShowChat("SYSTEM", "Starting in " & string(pCountdownMs div 1000 + 1) & "...", 2)
  else if pPhase = 2 then
    BR4MPShowChat("SYSTEM", "GO!", 2)
  end if
end

on BR4MPGameStanding pId, pLap, pCp, pFinished, pFinishMs
  BR4MPEnsure
  -- keep a simple table the HUD can draw; index 1 = leader
  gBR4MP.standings.add([#id: pId, #lap: pLap, #cp: pCp, #finished: pFinished, #timeMs: pFinishMs])
end

on BR4MPGameEvent pEvent, pActor, pTarget, pValue, pPos
  case pEvent of
    5: BR4MPShowChat("SYSTEM", BR4MPPlayerName(pActor) & " respawned.", 2)
    4:
      BR4MPShowChat("SYSTEM", BR4MPPlayerName(pTarget) & " was destroyed by " & BR4MPPlayerName(pActor) & ".", 2)
    9: BR4MPShowChat("SYSTEM", "GO!", 2)
    10: BR4MPShowChat("SYSTEM", "Lap in " & string(pValue / 1000.0) & "s", 2)
    11: BR4MPShowChat("SYSTEM", BR4MPPlayerName(pActor) & " finished!", 2)
    16: gBR4MP.invitedRoom = pValue
    17: -- pickup respawned: nothing to do, the world model already shows it
  end case
end

on BR4MPGameCorrection pReason, pPos, pRot
  -- Trust the server: reason 1/2 (respawn / race start) are authoritative
  -- teleports, reason 0 is the anti-cheat pulling us back.
  BR4MPLocalTransform().position = vector(pPos[1], pPos[2], pPos[3])
  if pReason = 0 then
    BR4MPShowChat("SYSTEM", "Position corrected by the server.", 2)
  end if
end

on BR4MPGameError pCode, pMessage
  gBR4MP.lastError = pMessage
  BR4MPShowChat("SYSTEM", "Error " & string(pCode) & ": " & pMessage, 2)
end

-- ── public API for the original UI ─────────────────────────────────────
on BR4MPChat pText
  BR4MPEnsure
  if not BR4MPActive() then return
  if pText = "" then return
  BR4MPSendNow("CHAT|ch=0,x=" & BR4MPEncode(pText))
end

on BR4MPAction pAction
  BR4MPEnsure
  BR4MPSendLine("ACTION|a=" & string(pAction) & ",t=0,arg=0")
end

on BR4MPHit pTargetId, pWeapon, pPos
  BR4MPEnsure
  BR4MPSendLine("HIT|t=" & string(pTargetId) & ",w=" & string(pWeapon) & ¬
                ",px=" & BR4MPFixed(pPos[1]) & ",py=" & BR4MPFixed(pPos[2]) & ",pz=" & BR4MPFixed(pPos[3]) & ¬
                ",ct=" & string(the milliseconds) & ",d=0")
end

on BR4MPAcceptInvite
  BR4MPEnsure
  if gBR4MP.invitedRoom = 0 then return
  BR4MPSendNow("ACTION|a=6,t=0,arg=" & string(gBR4MP.invitedRoom))
end

on BR4MPPlayerName pId
  BR4MPEnsure
  pPlayer = gBR4MP.players[pId]
  if pPlayer = VOID then return "#" & string(pId)
  return pPlayer.name
end

-- ── HUD ────────────────────────────────────────────────────────────────
on BR4MPShowChat pName, pText, pChannel
  BR4MPEnsure
  gBR4MP.chat.add([#name: pName, #text: pText, #channel: pChannel])
  if gBR4MP.chat.count > 8 then gBR4MP.chat.deleteAt(1)
  if gBR4MP.chatMember <> VOID then
    pMember = gBR4MP.chatMember
    pMember.text = pName & ": " & pText
  end if
end

on BR4MPChatMember pMember
  -- Pass the text member that should show the newest line.
  gBR4MP.chatMember = pMember
end

on BR4MPUpdateStatus
  BR4MPEnsure
  pPhaseName = ["LOBBY", "COUNTDOWN", "RACING", "FINISHING", "RESULTS"]
  pName = pPhaseName[gBR4MP.phase + 1]
  if pName = VOID then pName = "—"
  gBR4MP.statusText = gBR4MP.roomId & " · " & pName & ¬
                      " · lap " & string(gBR4MP.lap) & "/" & string(gBR4MP.totalLaps) & ¬
                      " · " & string(gBR4MP.players.count) & "p" & ¬
                      " · " & string(gBR4MP.rttMs) & "ms"
end

on BR4MPStatusText
  BR4MPEnsure
  return gBR4MP.statusText
end
